{
  "name": "@studiohyperdrive/logger",
  "version": "1.1.4",
  "description": "SHD logging module: an abstraction on console.log for both frontend as backend (Node.js).",
  "main": "dist/shd-logger.cjs.js",
  "module": "dist/shd-logger.esm.js",
  "browser": "dist/shd-logger.umd.js",
  "types": "dist/shd-logger.d.ts",
  "scripts": {
    "start": "npm i && npm run build",
    "build": "NODE_ENV=production ./scripts/build.sh",
    "release": "npm run build && ./scripts/release.sh",
    "lint": "eslint . -c eslint.config.mjs"
  },
  "repository": {
    "type": "git",
    "url": "ssh://git@github.com:studiohyperdrive/logger.git"
  },
  "author": "Niels Bril <niels.bril@studiohyperdrive.be>",
  "contributors": [
    "Niels Bril <niels.bril@studiohyperdrive.be>"
  ],
  "license": "ISC",
  "homepage": "https://github.com/studiohyperdrive/logger",
  "dependencies": {
    "dateformat": "3.0.3",
    "signale": "1.4.0",
    "winston": "3.2.1",
    "winston-daily-rotate-file": "3.8.0",
    "winston-transport": "4.3.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.23.0",
    "@babel/core": "^7.23.0",
    "@babel/plugin-external-helpers": "^7.22.0",
    "@babel/plugin-transform-object-rest-spread": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@babel/eslint-parser": "^7.23.0",
    "@rollup/plugin-babel": "^6.0.0",
    "@rollup/plugin-commonjs": "^25.0.0",
    "@rollup/plugin-json": "^6.0.0",
    "@rollup/plugin-node-resolve": "^15.2.0",
    "@rollup/plugin-terser": "^0.4.0",
    "eslint": "9.34.0",
    "globals": "15.11.0",
    "rollup": "^4.0.0",
    "rollup-plugin-visualizer": "^5.9.0"
  }
